set(ARMV8M_MAIN_CPU_FLAGS "-mcpu=cortex-m33+nodsp+nofp -mfloat-abi=soft -Wno-atomic-alignment")

set(CMAKE_SYSTEM_NAME Generic CACHE STRING "")
set(CMAKE_SYSTEM_PROCESSOR arm CACHE STRING "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING "")
set(CMAKE_CROSSCOMPILING ON CACHE BOOL "")
set(LLVM_CMAKE_DIR "" CACHE PATH "" FORCE)
set(LLVM_CONFIG_PATH "" CACHE FILEPATH "" FORCE)

set(CMAKE_C_COMPILER_TARGET armv8m.main-none-eabi CACHE STRING "")
set(CMAKE_CXX_COMPILER_TARGET armv8m.main-none-eabi CACHE STRING "")
set(CMAKE_ASM_COMPILER_TARGET armv8m.main-none-eabi CACHE STRING "")
set(LLVM_TARGET_TRIPLE armv8m.main-none-eabi CACHE STRING "")
set(LLVM_DEFAULT_TARGET_TRIPLE armv8m.main-none-eabi CACHE STRING "")

foreach(lang C CXX ASM)
  set(CMAKE_${lang}_FLAGS "${ARMV8M_MAIN_CPU_FLAGS}" CACHE STRING "")
endforeach()

set(COMPILER_RT_BUILD_BUILTINS ON CACHE BOOL "")
set(COMPILER_RT_BUILD_SANITIZERS OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_XRAY OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_LIBFUZZER OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_PROFILE OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_MEMPROF OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_ORC OFF CACHE BOOL "")
set(COMPILER_RT_BUILD_GWP_ASAN OFF CACHE BOOL "")
set(COMPILER_RT_BUILTINS_ENABLE_PIC OFF CACHE BOOL "")
set(COMPILER_RT_BAREMETAL_BUILD ON CACHE BOOL "" FORCE)
set(COMPILER_RT_DEFAULT_TARGET_ONLY ON CACHE BOOL "")
set(COMPILER_RT_SUPPORTED_ARCH arm CACHE STRING "")
